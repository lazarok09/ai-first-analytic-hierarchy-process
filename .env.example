# Auth.js (NextAuth v5)
AUTH_SECRET=generate-a-long-random-string
# Optional in local; set in production / behind proxy
AUTH_URL=http://localhost:3000

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local MVP: email-only Credentials provider (no OAuth secrets required)
AUTH_DEV_LOGIN=true

# SQLite database path (default: ./data/ahp.db)
AHP_DB_PATH=

# Dev-only: allow x-user-id header even when NODE_ENV=production
# ALLOW_X_USER_ID=1

# In-app ChatKit agent (Python FastAPI sidecar)
OPENAI_API_KEY=
# Upstream ChatKit protocol server (proxied by Next at /api/chatkit)
CHATKIT_AGENT_URL=http://127.0.0.1:8000
# Public URL the widget calls (same-origin proxy by default)
CHATKIT_PUBLIC_URL=/api/chatkit
# Domain key required by @openai/chatkit-react CustomApiConfig
CHATKIT_DOMAIN_KEY=domain_pk_localhost
# Base URL the Python agent uses to call Next REST APIs
AHP_API_BASE_URL=http://127.0.0.1:3000
